@page "/account"
@model DentalLabOS.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = L["Account.Title"];
}
<div class="page-header">
    <div class="titles">
        <h1>@L["Account.Title"] <span class="screen-id">SYS-01</span></h1>
        <p class="lead">@L["Account.Lead"]</p>
    </div>
</div>
<div class="grid grid-main">
    <div class="card">
        <div class="card-header"><h2>@L["Account.Info"]</h2></div>
        <div class="card-body">
            <div class="flex items-center gap-3 mb-6">
                <span class="avatar avatar-lg">@Model.Initials</span>
                <div>
                    <h3>@Model.FullName</h3>
                    <span class="muted ltr">@Model.Email</span>
                </div>
            </div>
            <dl class="dl">
                <div><dt>@L["Account.Workspace"]</dt><dd>@(Model.LabName ?? L["App.PlatformPortal"].Value)</dd></div>
                <div><dt>@L["Fields.Roles"]</dt><dd class="flex gap-2 wrap">@foreach (var r in Model.Roles) { <span class="badge badge-brand">@r</span> }</dd></div>
                <div><dt>@L["Account.LastLogin"]</dt><dd>@(Model.LastLogin?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? "—")</dd></div>
                <div><dt>@L["Account.Permissions"]</dt><dd>@Model.PermissionCount</dd></div>
            </dl>
        </div>
    </div>
    <div class="stack">
        <a class="card" href="/account/preferences" style="display:block; color:inherit; text-decoration:none">
            <div class="card-body flex items-center gap-3"><span class="stat-icon"><icon name="settings" /></span><div><strong>@L["Nav.Preferences"]</strong><p class="muted text-sm" style="margin:0">@L["Prefs.Lead"]</p></div></div>
        </a>
        <a class="card" href="/account/password" style="display:block; color:inherit; text-decoration:none">
            <div class="card-body flex items-center gap-3"><span class="stat-icon tone-violet"><icon name="lock" /></span><div><strong>@L["Nav.ChangePassword"]</strong><p class="muted text-sm" style="margin:0">@L["Password.Lead"]</p></div></div>
        </a>
    </div>
</div>
