@page "/account/password"
@model DentalLabOS.Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = L["Nav.ChangePassword"];
}
<div class="page-header">
    <div class="titles">
        <nav class="breadcrumbs"><a href="/account">@L["Account.Title"]</a><icon name="chevron-left" class="icon-dir" /><span>@L["Nav.ChangePassword"]</span></nav>
        <h1>@L["Nav.ChangePassword"] <span class="screen-id">AUTH-07</span></h1>
        <p class="lead">@L["Password.Lead"]</p>
    </div>
</div>
<form method="post" class="card" style="max-width: 640px" novalidate>
    <div class="card-body">
        <partial name="_ValidationSummary" />
        <div class="form-grid">
            <div class="field">
                <label class="label" asp-for="Current">@L["Fields.CurrentPassword"]</label>
                <input class="input input-ltr" asp-for="Current" type="password" autocomplete="current-password" dir="ltr" />
            </div>
            <div class="field">
                <label class="label" asp-for="New">@L["Fields.NewPassword"]</label>
                <input class="input input-ltr" asp-for="New" type="password" autocomplete="new-password" dir="ltr" />
                <span class="hint">@L["Auth.PasswordPolicy"]</span>
                <span class="field-error" asp-validation-for="New"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Confirm">@L["Fields.ConfirmPassword"]</label>
                <input class="input input-ltr" asp-for="Confirm" type="password" autocomplete="new-password" dir="ltr" />
                <span class="field-error" asp-validation-for="Confirm"></span>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit"><icon name="check" /> @L["Password.Submit"]</button>
        </div>
    </div>
</form>
