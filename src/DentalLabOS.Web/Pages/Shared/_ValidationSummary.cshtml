@{
    var general = ViewContext.ModelState[string.Empty]?.Errors;
}
@if (general is { Count: > 0 })
{
    <div class="alert alert-danger mb-4" role="alert">
        <icon name="circle-alert" />
        <div>
            @foreach (var e in general)
            {
                <p>@e.ErrorMessage</p>
            }
        </div>
    </div>
}
