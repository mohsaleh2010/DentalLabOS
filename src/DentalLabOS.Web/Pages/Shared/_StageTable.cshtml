@* Stages of a work order with the actions the signed-in user may take (the server re-checks scope and order). *@
@using DentalLabOS.Contracts.Production
@using DentalLabOS.Domain.Security
@model (WorkOrderDto Wo, bool CanTransition)
@{
    var wo = Model.Wo;
    var canAct = Model.CanTransition && wo.Status is "Ready" or "InProduction";
    var back = $"/workorders/{wo.Id}?tab=stages";
}
<section class="card">
    <div class="card-header"><h2>@L["WorkOrders.Tab.Stages"]</h2>
        @if (Model.CanTransition && wo.Status is "Ready" or "InProduction" or "ReadyForDelivery")
        {
            <a class="btn btn-sm ms-auto" href="/workorders/@wo.Id/transition"><icon name="route" class="icon-sm" /> @L["WorkOrders.Transition"]</a>
        }
    </div>
    <div class="table-wrap">
        <table class="table table-responsive">
            <thead><tr><th>#</th><th>@L["Fields.Stage"]</th><th>@L["Fields.Department"]</th><th>@L["Fields.Status"]</th><th>@L["Fields.AssignedTo"]</th><th class="num">@L["WorkOrders.Worked"]</th><th class="num">@L["Fields.TargetHours"]</th><th class="actions"></th></tr></thead>
            <tbody>
            @foreach (var s in wo.Stages)
            {
                <tr class="@(s.IsAvailable ? "row-current" : null)">
                    <td data-label="#"><span class="step-no">@s.Step</span></td>
                    <td class="cell-primary"><strong>@s.Name</strong>@if (s.SkipReason is not null) {<div class="text-xs muted">@s.SkipReason</div>}</td>
                    <td data-label="@L["Fields.Department"]">@(s.DepartmentName ?? "—")</td>
                    <td data-label="@L["Fields.Status"]"><partial name="_StatusBadge" model="StatusUi.Stage(s.Status)" />@if (s.IsOverTarget) {<span class="badge badge-danger" title="@L["WorkOrders.OverTarget"]"><icon name="timer" /></span>}</td>
                    <td data-label="@L["Fields.AssignedTo"]">@(s.AssigneeName ?? "—")</td>
                    <td data-label="@L["WorkOrders.Worked"]" class="num">@L["Common.Minutes", Math.Round(s.WorkedMinutes)]</td>
                    <td data-label="@L["Fields.TargetHours"]" class="num">@Fmt.Qty(s.TargetHours)</td>
                    <td class="actions">
                        @if (canAct && s.IsAvailable)
                        {
                            <form method="post" class="inline-actions" action="/workorders/@wo.Id?tab=stages">
                                <input type="hidden" name="stageId" value="@s.Id" /><input type="hidden" name="back" value="@back" />
                                @if (s.Status is "Pending" or "Paused")
                                {
                                    <button class="btn btn-sm btn-primary" type="submit" formaction="/workorders/@wo.Id?handler=Start"><icon name="play" class="icon-sm" /> @L[s.Status == "Paused" ? "WorkOrders.Resume" : "WorkOrders.Start"]</button>
                                }
                                @if (s.Status == "InProgress")
                                {
                                    <button class="btn btn-sm" type="submit" formaction="/workorders/@wo.Id?handler=Pause"><icon name="pause" class="icon-sm" /> @L["WorkOrders.Pause"]</button>
                                }
                                @if (s.Status is "InProgress" or "Paused")
                                {
                                    <button class="btn btn-sm btn-primary" type="submit" formaction="/workorders/@wo.Id?handler=Complete"><icon name="check" class="icon-sm" /> @L["WorkOrders.Complete"]</button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
