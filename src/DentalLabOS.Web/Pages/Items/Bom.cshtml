@page "/items/{id:guid}/bom"
@model DentalLabOS.Web.Pages.Items.BomModel
@{
    var s = Model.Service;
    ViewData["Title"] = L["Items.Bom"];
    var editing = Model.Edit is not null;
}
<div class="page-header">
    <div class="titles">
        <nav class="breadcrumbs"><a href="/items">@L["Nav.Items"]</a><icon name="chevron-left" class="icon-dir" /><a href="/items/@s.Id">@s.Name</a><icon name="chevron-left" class="icon-dir" /><span>@L["Items.Bom"]</span></nav>
        <h1>@L["Items.Bom"] — @s.Name <span class="screen-id">ITM-06</span></h1>
        <p class="lead">@L["Items.BomLead"]</p>
    </div>
</div>
<div class="split">
    <section class="card">
        <partial name="_BomTable" model="(Model.Lines, true)" />
    </section>
    <form method="post" class="card" asp-route-edit="@Model.Edit" data-guard novalidate>
        <div class="card-header"><h2>@(editing ? L["Items.EditMaterial"] : L["Items.AddMaterial"])</h2></div>
        <div class="card-body">
            <partial name="_ValidationSummary" />
            @if (Model.Materials.Count == 0)
            {
                <div class="alert alert-warning"><icon name="triangle-alert" /><div>@L["Items.NoMaterials"] <a href="/items/new/edit?type=Material">@L["Items.New"]</a></div></div>
            }
            <div class="field">
                <label class="label" asp-for="Input.MaterialItemId">@L["Items.Material"]<span class="req">*</span></label>
                <select class="select" asp-for="Input.MaterialItemId" required>
                    @foreach (var m in Model.Materials)
                    {
                        <option value="@m.Id">@m.Name (@m.Code)</option>
                    }
                </select>
                <span class="field-error" asp-validation-for="Input.MaterialItemId"></span>
            </div>
            <div class="form-grid cols-2">
                <div class="field">
                    <label class="label" asp-for="Input.Quantity">@L["Fields.Quantity"]<span class="req">*</span></label>
                    <input class="input input-ltr" asp-for="Input.Quantity" type="number" step="any" min="0" dir="ltr" value="@(Model.Input.Quantity == 0 ? "" : Fmt.Input(Model.Input.Quantity))" required />
                    <span class="field-error" asp-validation-for="Input.Quantity"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.UnitId">@L["Fields.Unit"]</label>
                    <select class="select" asp-for="Input.UnitId">
                        @foreach (var u in Model.Units)
                        {
                            <option value="@u.Id">@u.Code</option>
                        }
                    </select>
                    <span class="field-error" asp-validation-for="Input.UnitId"></span>
                </div>
            </div>
            <div class="field">
                <label class="label" asp-for="Input.ScrapPercent">@L["Items.Scrap"] (%)</label>
                <input class="input input-ltr" asp-for="Input.ScrapPercent" type="number" step="0.1" min="0" max="100" dir="ltr" value="@Fmt.Input(Model.Input.ScrapPercent)" />
                <span class="hint">@L["Items.ScrapHint"]</span>
                <span class="field-error" asp-validation-for="Input.ScrapPercent"></span>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit" disabled="@(Model.Materials.Count == 0)"><icon name="check" /> @L["Common.Save"]</button>
                @if (editing)
                {
                    <a class="btn btn-ghost" href="/items/@s.Id/bom">@L["Common.Cancel"]</a>
                }
            </div>
        </div>
    </form>
</div>
