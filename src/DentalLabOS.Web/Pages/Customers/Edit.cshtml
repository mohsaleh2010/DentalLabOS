@page "/customers/{id}/edit"
@model DentalLabOS.Web.Pages.Customers.EditModel
@using DentalLabOS.Domain.Security
@{
    ViewData["Title"] = Model.IsNew ? L["Customers.New"] : L["Customers.Edit"];
    var canCredit = Model.Can(Permissions.Customers.CreditManage);
    string[] types = ["Clinic", "Center", "Dentist", "Individual"];
}
<div class="page-header">
    <div class="titles">
        <nav class="breadcrumbs"><a href="/customers">@L["Nav.Customers"]</a><icon name="chevron-left" class="icon-dir" />@if (!Model.IsNew) {<a href="/customers/@Model.Id">@Model.Input.Name</a><icon name="chevron-left" class="icon-dir" />}<span>@ViewData["Title"]</span></nav>
        <h1>@ViewData["Title"] <span class="screen-id">CUS-02</span></h1>
    </div>
</div>
<form method="post" class="card" style="max-width: 980px" data-guard novalidate>
    <div class="card-body">
        <partial name="_ValidationSummary" />
        <input type="hidden" asp-for="Input.RowVersion" />
        <div class="form-section">
            <h2 class="form-section-title">@L["Customers.Section.Basic"]</h2>
            <div class="form-grid cols-2">
                <div class="field">
                    <label class="label" asp-for="Input.Name">@L["Fields.Name"]<span class="req">*</span></label>
                    <input class="input" asp-for="Input.Name" required maxlength="200" autofocus />
                    <span class="field-error" asp-validation-for="Input.Name"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.Code">@L["Fields.Code"]@if (!Model.IsNew) {<span class="req">*</span>}</label>
                    <input class="input input-ltr" asp-for="Input.Code" dir="ltr" maxlength="20" placeholder="@(Model.IsNew ? "C-00001" : null)" />
                    <span class="hint">@(Model.IsNew ? L["Fields.AutoCodeHint"] : L["Fields.CodeHint"])</span>
                    <span class="field-error" asp-validation-for="Input.Code"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.Type">@L["Fields.Type"]<span class="req">*</span></label>
                    <select class="select" asp-for="Input.Type">
                        @foreach (var t in types)
                        {
                            <option value="@t">@L[$"PartyType.{t}"]</option>
                        }
                    </select>
                    <span class="field-error" asp-validation-for="Input.Type"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.GroupId">@L["Fields.Group"]</label>
                    <select class="select" asp-for="Input.GroupId">
                        <option value="">—</option>
                        @foreach (var g in Model.Groups)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                    <span class="field-error" asp-validation-for="Input.GroupId"></span>
                </div>
            </div>
        </div>
        <div class="form-section">
            <h2 class="form-section-title">@L["Customers.Section.Contact"]</h2>
            <div class="form-grid cols-2">
                <div class="field">
                    <label class="label" asp-for="Input.Mobile">@L["Fields.Mobile"]</label>
                    <input class="input input-ltr" asp-for="Input.Mobile" type="tel" dir="ltr" maxlength="50" />
                    <span class="field-error" asp-validation-for="Input.Mobile"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.Phone">@L["Fields.Phone"]</label>
                    <input class="input input-ltr" asp-for="Input.Phone" type="tel" dir="ltr" maxlength="50" />
                    <span class="field-error" asp-validation-for="Input.Phone"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.Email">@L["Fields.Email"]</label>
                    <input class="input input-ltr" asp-for="Input.Email" type="email" dir="ltr" maxlength="256" />
                    <span class="field-error" asp-validation-for="Input.Email"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.City">@L["Fields.City"]</label>
                    <input class="input" asp-for="Input.City" maxlength="100" />
                    <span class="field-error" asp-validation-for="Input.City"></span>
                </div>
                <div class="field span-2">
                    <label class="label" asp-for="Input.Address">@L["Fields.Address"]</label>
                    <textarea class="textarea" asp-for="Input.Address" maxlength="500" rows="2"></textarea>
                    <span class="field-error" asp-validation-for="Input.Address"></span>
                </div>
            </div>
        </div>
        <div class="form-section">
            <h2 class="form-section-title">@L["Customers.Section.Commercial"]</h2>
            <div class="form-grid cols-2">
                <div class="field">
                    <label class="label" asp-for="Input.PriceListId">@L["Fields.PriceList"]</label>
                    @if (Model.Can(Permissions.PriceLists.Read))
                    {
                        <select class="select" asp-for="Input.PriceListId">
                            <option value="">@L["Customers.PriceListInherit"]</option>
                            @foreach (var p in Model.PriceLists)
                            {
                                <option value="@p.Id">@p.Name @(p.IsDefault ? $"({L["PriceLists.Default"]})" : "")</option>
                            }
                        </select>
                        <span class="hint">@L["Customers.PriceListHint"]</span>
                    }
                    else
                    {
                        <input type="hidden" asp-for="Input.PriceListId" />
                        <p class="hint">@L["Common.NoPermissionToChange"]</p>
                    }
                    <span class="field-error" asp-validation-for="Input.PriceListId"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.TaxNumber">@L["Fields.TaxNumber"]</label>
                    <input class="input input-ltr" asp-for="Input.TaxNumber" dir="ltr" maxlength="50" />
                    <span class="field-error" asp-validation-for="Input.TaxNumber"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.PaymentTermsDays">@L["Fields.PaymentTermsDays"]</label>
                    <input class="input" asp-for="Input.PaymentTermsDays" type="number" min="0" max="365" />
                    <span class="field-error" asp-validation-for="Input.PaymentTermsDays"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.OpeningBalance">@L["Fields.OpeningBalance"]</label>
                    <input class="input input-ltr" asp-for="Input.OpeningBalance" type="number" step="0.01" dir="ltr" value="@Fmt.Input(Model.Input.OpeningBalance)" />
                    <span class="hint">@L["Customers.OpeningBalanceHint"]</span>
                    <span class="field-error" asp-validation-for="Input.OpeningBalance"></span>
                </div>
                @if (canCredit)
                {
                    <div class="field">
                        <label class="label" asp-for="Input.CreditLimit">@L["Fields.CreditLimit"]</label>
                        <input class="input input-ltr" asp-for="Input.CreditLimit" type="number" step="0.01" min="0" dir="ltr" value="@Fmt.Input(Model.Input.CreditLimit)" />
                        <span class="hint">@L["Customers.CreditLimitHint"]</span>
                        <span class="field-error" asp-validation-for="Input.CreditLimit"></span>
                    </div>
                    <label class="switch" style="align-self:center"><input type="checkbox" asp-for="Input.BlockWhenOverCredit" /> @L["Fields.BlockWhenOverCredit"]</label>
                }
                else
                {
                    <input type="hidden" asp-for="Input.CreditLimit" value="@Fmt.Input(Model.Input.CreditLimit)" />
                    <input type="hidden" asp-for="Input.BlockWhenOverCredit" />
                    <div class="field">
                        <span class="label">@L["Fields.CreditLimit"]</span>
                        <p class="money">@(Model.Input.CreditLimit == 0 ? L["Customers.NoLimit"].Value : Fmt.Money(Model.Input.CreditLimit))</p>
                        <span class="field-error" asp-validation-for="Input.CreditLimit"></span>
                    </div>
                }
                <div class="field span-2">
                    <label class="label" asp-for="Input.InternalNotes">@L["Fields.InternalNotes"]</label>
                    <textarea class="textarea" asp-for="Input.InternalNotes" maxlength="2000" rows="3"></textarea>
                    <span class="hint">@L["Customers.InternalNotesHint"]</span>
                </div>
                @if (!Model.IsNew)
                {
                    <label class="switch span-2"><input type="checkbox" asp-for="Input.IsActive" /> @L["Common.Active"] <span class="hint">@L["Customers.InactiveHint"]</span></label>
                }
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit"><icon name="check" /> @L["Common.Save"]</button>
            <a class="btn btn-ghost" href="@(Model.IsNew ? "/customers" : $"/customers/{Model.Id}")">@L["Common.Cancel"]</a>
        </div>
    </div>
</form>
