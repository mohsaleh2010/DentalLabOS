@page "/admin/users/{id:guid}/technician"
@model DentalLabOS.Web.Pages.Admin.Users.TechnicianModel
@{
    var p = Model.Profile;
    ViewData["Title"] = L["Technician.Title"];
}
<div class="page-header">
    <div class="titles">
        <nav class="breadcrumbs"><a href="/admin/users">@L["Nav.Users"]</a><icon name="chevron-left" class="icon-dir" /><a href="/admin/users/@p.UserProfileId">@p.FullName</a><icon name="chevron-left" class="icon-dir" /><span>@L["Technician.Title"]</span></nav>
        <h1>@L["Technician.Title"] <span class="screen-id">ADM-07</span></h1>
        <p class="lead">@p.FullName · @L["Technician.OpenTasks", p.OpenTasks]</p>
    </div>
</div>
@if (!p.HasProfile)
{
    <div class="alert alert-info mb-4"><icon name="info" /><div><p>@L["Technician.NoProfile"]</p></div></div>
}
<form method="post" class="card" style="max-width: 760px" data-guard novalidate>
    <div class="card-body">
        <partial name="_ValidationSummary" />
        <input type="hidden" asp-for="Input.RowVersion" />
        <div class="form-grid cols-2">
            <div class="field">
                <label class="label" asp-for="Input.DepartmentId">@L["Fields.Department"]<span class="req">*</span></label>
                <select class="select" asp-for="Input.DepartmentId" required>
                    <option value="">@L["Common.Choose"]</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
                <span class="hint">@L["Technician.DepartmentHint"]</span>
                <span class="field-error" asp-validation-for="Input.DepartmentId"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Input.DifficultyCapacityPerDay">@L["Fields.DailyCapacity"]</label>
                <input class="input input-ltr" asp-for="Input.DifficultyCapacityPerDay" type="number" step="0.5" min="0" dir="ltr" value="@Fmt.Input(Model.Input.DifficultyCapacityPerDay)" />
                <span class="hint">@L["Technician.CapacityHint"]</span>
                <span class="field-error" asp-validation-for="Input.DifficultyCapacityPerDay"></span>
            </div>
            @if (Model.CanSeeRate)
            {
                <div class="field">
                    <label class="label" asp-for="Input.LaborRatePerHour">@L["Fields.LaborRate"] <icon name="lock" class="icon-sm" /></label>
                    <input class="input input-ltr" asp-for="Input.LaborRatePerHour" type="number" step="0.01" min="0" dir="ltr" value="@(Model.Input.LaborRatePerHour is { } r ? Fmt.Input(r) : "")" />
                    <span class="hint">@L["Technician.RateHint"]</span>
                    <span class="field-error" asp-validation-for="Input.LaborRatePerHour"></span>
                </div>
            }
            <div class="field span-all">
                <label class="label" asp-for="Input.Skills">@L["Fields.Skills"]</label>
                <textarea class="textarea" asp-for="Input.Skills" rows="3" maxlength="1000" placeholder="@L["Technician.SkillsHint"]"></textarea>
                <span class="field-error" asp-validation-for="Input.Skills"></span>
            </div>
        </div>
        <div class="form-actions">
            <a class="btn btn-ghost" href="/admin/users/@p.UserProfileId">@L["Common.Cancel"]</a>
            <button class="btn btn-primary" type="submit"><icon name="check" /> @L["Common.Save"]</button>
        </div>
    </div>
</form>
