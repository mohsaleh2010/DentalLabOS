@page "/admin/taxes"
@model DentalLabOS.Web.Pages.Admin.Catalog.TaxesModel
@{
    ViewData["Title"] = L["Nav.Taxes"];
    var editing = Model.Edit is not null;
}
<div class="page-header">
    <div class="titles">
        <h1>@L["Nav.Taxes"] <span class="screen-id">ADM-12</span></h1>
        <p class="lead">@L["Taxes.Lead"]</p>
    </div>
</div>
<div class="alert alert-warning mb-6"><icon name="triangle-alert" /><div>@L["Taxes.AccountantNote"]</div></div>
<div class="split">
    <section class="card">
        @if (Model.TaxCodes.Count == 0)
        {
            <component type="typeof(EmptyState)" render-mode="Static" param-Title="@L["Taxes.Empty"].Value" param-Description="@L["Taxes.EmptyText"].Value" param-IconName="@("percent")" />
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-responsive">
                    <thead><tr><th>@L["Fields.Name"]</th><th>@L["Fields.Code"]</th><th class="num">@L["Taxes.Rate"]</th><th>@L["Fields.Type"]</th><th>@L["Fields.Status"]</th><th class="actions"></th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.TaxCodes)
                    {
                        <tr>
                            <td class="cell-primary"><strong>@t.Name</strong></td>
                            <td data-label="@L["Fields.Code"]"><code>@t.Code</code></td>
                            <td data-label="@L["Taxes.Rate"]" class="num"><strong>@t.Rate.ToString("0.####", CultureInfo.InvariantCulture)%</strong></td>
                            <td data-label="@L["Fields.Type"]">@(t.IsWithholding ? L["Taxes.Withholding"] : L["Taxes.Sales"])</td>
                            <td data-label="@L["Fields.Status"]"><partial name="_StatusBadge" model="StatusUi.Active(t.IsActive)" /></td>
                            <td class="actions"><a class="btn btn-sm" href="?edit=@t.Id"><icon name="pencil" class="icon-sm" /> @L["Common.Edit"]</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <form method="post" class="card" asp-route-edit="@Model.Edit" data-guard novalidate>
        <div class="card-header"><h2>@(editing ? L["Taxes.Edit"] : L["Taxes.New"])</h2></div>
        <div class="card-body">
            <partial name="_ValidationSummary" />
            <input type="hidden" asp-for="Input.RowVersion" />
            <div class="field">
                <label class="label" asp-for="Input.Name">@L["Fields.Name"]<span class="req">*</span></label>
                <input class="input" asp-for="Input.Name" maxlength="150" required />
                <span class="field-error" asp-validation-for="Input.Name"></span>
            </div>
            <div class="form-grid cols-2">
                <div class="field">
                    <label class="label" asp-for="Input.Code">@L["Fields.Code"]<span class="req">*</span></label>
                    <input class="input input-ltr" asp-for="Input.Code" dir="ltr" maxlength="20" required />
                    <span class="field-error" asp-validation-for="Input.Code"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Input.Rate">@L["Taxes.Rate"] (%)<span class="req">*</span></label>
                    <input class="input input-ltr" asp-for="Input.Rate" type="number" step="0.01" min="0" max="100" dir="ltr" value="@Fmt.Input(Model.Input.Rate)" required />
                    <span class="field-error" asp-validation-for="Input.Rate"></span>
                </div>
            </div>
            <label class="switch"><input type="checkbox" asp-for="Input.IsWithholding" /> @L["Taxes.Withholding"]</label>
            @if (editing)
            {
                <label class="switch mt-2"><input type="checkbox" asp-for="Input.IsActive" /> @L["Common.Active"]</label>
            }
            <div class="form-actions">
                <button class="btn btn-primary" type="submit"><icon name="check" /> @L["Common.Save"]</button>
                @if (editing)
                {
                    <a class="btn btn-ghost" href="/admin/taxes">@L["Common.Cancel"]</a>
                }
            </div>
        </div>
    </form>
</div>
