@page "/admin/numbering"
@model DentalLabOS.Web.Pages.Admin.NumberingModel
@{
    ViewData["Title"] = L["Nav.Numbering"];
}
<div class="page-header">
    <div class="titles">
        <h1>@L["Nav.Numbering"] <span class="screen-id">ADM-11</span></h1>
        <p class="lead">@L["Admin.Numbering.Lead"]</p>
    </div>
</div>
<div class="alert mb-6"><icon name="info" /><div>@L["Admin.Numbering.Rule"]</div></div>
<partial name="_ValidationSummary" />
<section class="card">
    <div class="table-wrap">
        <table class="table table-responsive">
            <thead><tr><th>@L["Admin.Numbering.DocType"]</th><th>@L["Admin.Numbering.Prefix"]</th><th>@L["Admin.Numbering.Padding"]</th><th>@L["Admin.Numbering.Yearly"]</th><th>@L["Admin.Numbering.Next"]</th><th class="actions"></th></tr></thead>
            <tbody>
            @foreach (var s in Model.Sequences)
            {
                var formId = $"seq-{s.Id:N}";
                <tr>
                    <td class="cell-primary"><strong>@L[$"DocType.{s.DocumentType}"]</strong> <span class="text-xs muted">@(s.BranchName ?? L["Admin.Numbering.AllBranches"].Value) · @s.Year</span></td>
                    <td data-label="@L["Admin.Numbering.Prefix"]"><input form="@formId" class="input input-ltr" name="prefix" value="@s.Prefix" dir="ltr" style="max-width:110px; min-height:34px" maxlength="10" aria-label="@L["Admin.Numbering.Prefix"]" /></td>
                    <td data-label="@L["Admin.Numbering.Padding"]"><input form="@formId" class="input" type="number" name="padding" value="@s.Padding" min="3" max="10" style="max-width:90px; min-height:34px" aria-label="@L["Admin.Numbering.Padding"]" /></td>
                    <td data-label="@L["Admin.Numbering.Yearly"]"><label class="switch"><input form="@formId" type="checkbox" name="resetYearly" value="true" checked="@s.ResetYearly" aria-label="@L["Admin.Numbering.Yearly"]" /></label></td>
                    <td data-label="@L["Admin.Numbering.Next"]"><code class="badge badge-brand ltr">@s.Preview</code></td>
                    <td class="actions">
                        <form id="@formId" method="post" asp-route-sequenceId="@s.Id">
                            <input type="hidden" name="rowVersion" value="@s.RowVersion" />
                            <button class="btn btn-sm" type="submit"><icon name="check" class="icon-sm" /> @L["Common.Save"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
