@page "/admin/workflows/{id}"
@model DentalLabOS.Web.Pages.Admin.Workflows.EditModel
@{
    var c = Model.Current;
    ViewData["Title"] = Model.IsNew ? L["Workflows.New"] : c!.Name;
    var i = Model.Input;
    (string Prop, string Field)[] required = [("RequireDentist", "Dentist"), ("RequireTeeth", "Teeth"), ("RequireShade", "Shade"),
        ("RequireMaterial", "Material"), ("RequirePatientReference", "PatientReference"), ("RequireAttachment", "Attachment")];
    bool Flag(string p) => p switch
    {
        "RequireDentist" => i.RequireDentist, "RequireTeeth" => i.RequireTeeth, "RequireShade" => i.RequireShade, "RequireMaterial" => i.RequireMaterial,
        "RequirePatientReference" => i.RequirePatientReference, _ => i.RequireAttachment,
    };
}
<div class="page-header">
    <div class="titles">
        <nav class="breadcrumbs"><a href="/admin/workflows">@L["Nav.Workflows"]</a><icon name="chevron-left" class="icon-dir" /><span>@ViewData["Title"]</span></nav>
        <h1 class="flex items-center gap-3 wrap">@ViewData["Title"] @if (c is not null) {<span class="badge">v@(c.Version)</span>} <span class="screen-id">ADM-16</span></h1>
        <p class="lead">@L["Workflows.DesignerLead"]</p>
    </div>
</div>
<form method="post" novalidate data-guard data-workflow-designer>
    <input type="hidden" asp-for="Input.RowVersion" />
    <partial name="_ValidationSummary" />
    <div class="split">
        <div class="stack">
            <section class="card">
                <div class="card-body">
                    <div class="form-grid cols-2">
                        <div class="field">
                            <label class="label" asp-for="Input.Name">@L["Fields.Name"]<span class="req">*</span></label>
                            <input class="input" asp-for="Input.Name" maxlength="150" required />
                            <span class="field-error" asp-validation-for="Input.Name"></span>
                        </div>
                        <div class="field">
                            <label class="label" asp-for="Input.Description">@L["Fields.Description"]</label>
                            <input class="input" asp-for="Input.Description" maxlength="500" />
                        </div>
                    </div>
                    <div class="chip-row">
                        <label class="switch"><input type="checkbox" asp-for="Input.IsActive" /> @L["Common.Active"]</label>
                        <label class="switch"><input type="checkbox" asp-for="Input.IsDefault" /> @L["Workflows.MakeDefault"]</label>
                    </div>
                    <span class="field-error" asp-validation-for="Input.IsDefault"></span>
                </div>
            </section>
            <section class="card">
                <div class="card-header"><h2>@L["Workflows.StagesTitle"]</h2><span class="sub">@L["Workflows.StagesHint"]</span></div>
                <div class="table-wrap">
                    <table class="table stage-editor" data-stage-rows>
                        <thead><tr><th class="num">@L["Workflows.Step"]</th><th>@L["Fields.Stage"]</th><th>@L["Fields.Department"]</th><th class="num">@L["Fields.TargetHours"]</th><th>@L["Workflows.Quality"]</th><th class="actions"></th></tr></thead>
                        <tbody>
                        @for (var k = 0; k < i.Stages.Count; k++)
                        {
                            var s = i.Stages[k];
                            <tr data-stage-row>
                                <td class="num"><input type="hidden" name="Input.Stages[@k].Id" value="@s.Id" data-f="Id" />
                                    <input class="input input-ltr input-step" type="number" min="1" max="100" name="Input.Stages[@k].Step" value="@s.Step" aria-label="@L["Workflows.Step"]" dir="ltr" data-f="Step" /></td>
                                <td><input class="input" name="Input.Stages[@k].Name" value="@s.Name" maxlength="100" aria-label="@L["Fields.Stage"]" placeholder="@L["Workflows.StageName"]" data-f="Name" /></td>
                                <td><select class="select" name="Input.Stages[@k].DepartmentId" aria-label="@L["Fields.Department"]" data-f="DepartmentId">
                                        <option value="">—</option>
                                        @foreach (var d in Model.Departments)
                                        {
                                            <option value="@d.Id" selected="@(s.DepartmentId == d.Id)">@d.Name</option>
                                        }
                                    </select></td>
                                <td class="num"><input class="input input-ltr input-hours" type="number" step="0.5" min="0" name="Input.Stages[@k].TargetHours" value="@Fmt.Input(s.TargetHours)" aria-label="@L["Fields.TargetHours"]" dir="ltr" data-f="TargetHours" /></td>
                                <td><div class="qc-cell"><label class="check"><input type="checkbox" name="Input.Stages[@k].RequiresQualityPass" value="true" checked="@s.RequiresQualityPass" data-f="RequiresQualityPass" /> <span class="sr-only">@L["Workflows.Quality"]</span></label>
                                    <select class="select select-sm" name="Input.Stages[@k].QualityTemplateId" aria-label="@L["Workflows.Checklist"]" data-f="QualityTemplateId" hidden="@(!s.RequiresQualityPass)">
                                        <option value="">@L["Workflows.DefaultChecklist"]</option>
                                        @foreach (var t in Model.Templates)
                                        {
                                            <option value="@t.Id" selected="@(s.QualityTemplateId == t.Id)">@t.Name</option>
                                        }
                                    </select></div></td>
                                <td class="actions nowrap">
                                    <button class="btn btn-sm btn-ghost" type="button" data-row-up aria-label="@L["Workflows.MoveUp"]" hidden><icon name="arrow-up" class="icon-sm" /></button>
                                    <button class="btn btn-sm btn-ghost" type="button" data-row-down aria-label="@L["Workflows.MoveDown"]" hidden><icon name="arrow-down" class="icon-sm" /></button>
                                    <button class="btn btn-sm btn-ghost" type="button" data-row-remove aria-label="@L["Common.Delete"]" hidden><icon name="trash-2" class="icon-sm" /></button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer flex gap-2 wrap">
                    <button class="btn btn-sm" type="button" data-row-add hidden><icon name="plus" class="icon-sm" /> @L["Workflows.AddStage"]</button>
                    <button class="btn btn-sm" type="button" data-row-add-parallel hidden><icon name="git-branch" class="icon-sm" /> @L["Workflows.AddParallel"]</button>
                    <span class="hint">@L["Workflows.EmptyRowsHint"]</span>
                </div>
                <span class="field-error">@Html.ValidationMessage("Input.Stages")</span>
            </section>
        </div>
        <aside class="stack sticky-side">
            <section class="card">
                <div class="card-header"><h2>@L["Workflows.RequiredFields"]</h2></div>
                <div class="card-body stack">
                    <p class="hint">@L["Workflows.RequiredHint"]</p>
                    @foreach (var (prop, field) in required)
                    {
                        <div><label class="check"><input type="checkbox" name="Input.@prop" value="true" checked="@Flag(prop)" /> @L[$"IntakeField.{field}"]</label>
                            <input type="hidden" name="Input.@prop" value="false" /></div>
                    }
                </div>
            </section>
            <section class="card">
                <div class="card-header"><h2>@L["Workflows.Preview"]</h2></div>
                <div class="card-body">
                    <ol class="flow-preview" data-flow-preview data-parallel-text="@L["Workflows.Parallel"]">
                        @foreach (var g in i.Stages.Where(s => !string.IsNullOrWhiteSpace(s.Name)).GroupBy(s => s.Step).OrderBy(g => g.Key))
                        {
                            <li>@foreach (var s in g) {<span>@s.Name</span>}</li>
                        }
                    </ol>
                    <div class="alert alert-warning mt-4 text-sm"><icon name="info" /><div><p>@L["Workflows.VersionNote"]</p></div></div>
                </div>
                <div class="card-footer"><button class="btn btn-primary btn-block" type="submit"><icon name="check" /> @L["Common.Save"]</button></div>
            </section>
        </aside>
    </div>
</form>
