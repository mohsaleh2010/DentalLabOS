@page "/price-lists/bulk-update"
@model DentalLabOS.Web.Pages.PriceLists.BulkModel
@{
    ViewData["Title"] = L["PriceLists.Bulk"];
    var p = Model.Preview;
}
<div class="page-header">
    <div class="titles">
        <nav class="breadcrumbs"><a href="/price-lists">@L["PriceLists.Title"]</a><icon name="chevron-left" class="icon-dir" /><span>@L["PriceLists.Bulk"]</span></nav>
        <h1>@L["PriceLists.Bulk"] <span class="screen-id">ITM-09</span></h1>
        <p class="lead">@L["PriceLists.BulkLead"]</p>
    </div>
</div>
<ol class="steps">
    <li class="@(p is null ? "is-current" : null)">@L["PriceLists.BulkStep1"]</li>
    <li class="@(p is not null ? "is-current" : null)">@L["PriceLists.BulkStep2"]</li>
    <li>@L["PriceLists.BulkStep3"]</li>
</ol>
<form method="post" class="card mb-6" novalidate>
    <div class="card-body">
        <partial name="_ValidationSummary" />
        <div class="form-grid cols-2">
            <div class="field">
                <label class="label" asp-for="Input.PriceListId">@L["Fields.PriceList"]<span class="req">*</span></label>
                <select class="select" asp-for="Input.PriceListId">
                    @foreach (var l in Model.Lists)
                    {
                        <option value="@l.Id">@l.Name (@l.LineCount)</option>
                    }
                </select>
                <span class="field-error" asp-validation-for="Input.PriceListId"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Input.Percent">@L["PriceLists.Percent"]<span class="req">*</span></label>
                <div class="input-group"><input class="input input-ltr" asp-for="Input.Percent" type="number" step="0.01" min="-90" max="500" dir="ltr" value="@(Model.Input.Percent == 0 ? "" : Fmt.Input(Model.Input.Percent))" required /><span class="input-addon muted">%</span></div>
                <span class="hint">@L["PriceLists.PercentHint"]</span>
                <span class="field-error" asp-validation-for="Input.Percent"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Input.CategoryId">@L["Fields.Category"]</label>
                <select class="select" asp-for="Input.CategoryId">
                    <option value="">@L["Items.AllCategories"]</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@(c.ParentName is null ? c.Name : $"{c.ParentName} › {c.Name}")</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="label" asp-for="Input.ItemType">@L["Fields.Type"]</label>
                <select class="select" asp-for="Input.ItemType">
                    <option value="">@L["Items.AllTypes"]</option>
                    @foreach (var t in DentalLabOS.Web.Pages.Items.IndexModel.Types)
                    {
                        <option value="@t">@L[$"ItemType.{t}"]</option>
                    }
                </select>
                <span class="field-error" asp-validation-for="Input.ItemType"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Input.Decimals">@L["PriceLists.Rounding"]</label>
                <select class="select" asp-for="Input.Decimals">
                    <option value="0">1</option>
                    <option value="1">0.1</option>
                    <option value="2">0.01</option>
                </select>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn @(p is null ? "btn-primary" : null)" type="submit" asp-page-handler="Preview"><icon name="eye" /> @L["PriceLists.PreviewButton"]</button>
            @if (p is { Count: > 0 })
            {
                <button class="btn btn-primary" type="submit" asp-page-handler="Apply" data-confirm="@L["PriceLists.ApplyConfirm", p.Count]"><icon name="check" /> @L["PriceLists.ApplyButton", p.Count]</button>
            }
        </div>
    </div>
</form>
@if (p is not null)
{
    <section class="card">
        <div class="card-header"><h2>@L["PriceLists.PreviewTitle"]</h2></div>
        <div class="card-body">
            <div class="kpis mb-4">
                <div class="kpi"><span>@L["PriceLists.AffectedLines"]</span><strong>@p.Count</strong></div>
                <div class="kpi"><span>@L["PriceLists.OldTotal"]</span><strong class="money">@Fmt.Money(p.OldTotal)</strong></div>
                <div class="kpi"><span>@L["PriceLists.NewTotal"]</span><strong class="money @(p.NewTotal >= p.OldTotal ? "delta-up" : "delta-down")">@Fmt.Money(p.NewTotal)</strong></div>
            </div>
        </div>
        @if (p.Count == 0)
        {
            <component type="typeof(EmptyState)" render-mode="Static" param-Title="@L["PriceLists.NothingToChange"].Value" param-IconName="@("receipt")" />
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-responsive">
                    <thead><tr><th>@L["Fields.Item"]</th><th class="num">@L["Fields.MinQty"]</th><th class="num">@L["PriceLists.OldPrice"]</th><th class="num">@L["PriceLists.NewPrice"]</th></tr></thead>
                    <tbody>
                    @foreach (var c in p.Changes)
                    {
                        <tr>
                            <td class="cell-primary"><strong>@c.ItemName</strong> <code class="text-xs">@c.ItemSku</code></td>
                            <td data-label="@L["Fields.MinQty"]" class="num">@Fmt.Qty(c.MinQty)</td>
                            <td data-label="@L["PriceLists.OldPrice"]" class="num money muted">@Fmt.Money(c.OldPrice)</td>
                            <td data-label="@L["PriceLists.NewPrice"]" class="num money"><strong class="@(c.NewPrice >= c.OldPrice ? "delta-up" : "delta-down")">@Fmt.Money(c.NewPrice)</strong></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (p.Count > p.Changes.Count)
            {
                <p class="hint" style="padding: 0 var(--space-4) var(--space-4)">@L["PriceLists.PreviewTruncated", p.Changes.Count, p.Count]</p>
            }
        }
    </section>
}
