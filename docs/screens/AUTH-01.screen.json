{
  "$schema": "./_schema/screen.schema.json",
  "id": "AUTH-01",
  "module": "auth",
  "titleKey": "Auth.Login.Title",
  "route": "/login",
  "pattern": "AuthPage",
  "phase": 1,
  "status": "implemented",
  "permissions": {
    "view": null,
    "access": "anonymous"
  },
  "entities": [
    "ApplicationUser",
    "AuditLog"
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/v1/auth/token",
      "purpose": "API sign-in"
    }
  ],
  "rules": [
    "One generic message for unknown e-mail and wrong password (no account enumeration)",
    "Lockout after 5 failed attempts for 15 minutes",
    "Deactivated users and users of suspended/closed labs cannot sign in",
    "Every success and failure is written to AuditLog"
  ],
  "states": [
    "validationError",
    "locked"
  ],
  "offline": {
    "mode": "blocked",
    "why": "requires live server-side checks"
  },
  "sensitive": {
    "auditActions": [
      "Login",
      "LoginFailed"
    ],
    "secrets": [
      "password"
    ]
  },
  "aiAssist": {
    "allowed": [],
    "forbidden": [
      "*"
    ],
    "contextFields": []
  },
  "tests": [
    "AUTH-01.happy",
    "AUTH-01.badPassword",
    "AUTH-01.lockout",
    "AUTH-01.suspendedTenant"
  ],
  "relatedScreens": [
    "AUTH-05",
    "AUTH-06"
  ],
  "fields": [
    {
      "name": "email",
      "type": "email",
      "required": true,
      "maxLength": 256
    },
    {
      "name": "password",
      "type": "password",
      "required": true
    },
    {
      "name": "rememberMe",
      "type": "boolean"
    }
  ]
}
