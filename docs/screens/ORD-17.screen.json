{
  "$schema": "./_schema/screen.schema.json",
  "id": "ORD-17",
  "module": "quality",
  "titleKey": "Quality.QueueTitle",
  "route": "/quality/queue",
  "pattern": "DashboardPage",
  "phase": 4,
  "status": "implemented",
  "permissions": {
    "view": "quality.read",
    "access": "permission",
    "actions": {
      "inspect": "quality.inspect"
    }
  },
  "entities": [
    "QualityCheck",
    "QualityCheckItem",
    "WorkOrder",
    "WorkOrderStage",
    "StageTransitionLog"
  ],
  "api": [
    {
      "method": "GET",
      "path": "/api/v1/quality/overview",
      "purpose": "Counters"
    },
    {
      "method": "GET",
      "path": "/api/v1/quality/queue",
      "purpose": "Stages awaiting inspection (department filter)"
    },
    {
      "method": "GET",
      "path": "/api/v1/quality/checks",
      "purpose": "Recent decisions"
    }
  ],
  "rules": [
    "A stage that needs a quality pass waits here after the technician finishes it (AwaitingQuality); the order is InQuality",
    "Earliest due first, urgent first",
    "Earlier checks of the same order are flagged"
  ],
  "states": [
    "loading",
    "empty"
  ],
  "offline": {
    "mode": "blocked",
    "why": "requires live server-side checks"
  },
  "sensitive": {},
  "aiAssist": {
    "allowed": [
      "explainScreen"
    ],
    "forbidden": [
      "changeData",
      "changePermissions"
    ],
    "contextFields": []
  },
  "tests": [
    "ORD-17.happy",
    "ORD-17.permissionDenied",
    "ORD-17.crossTenant"
  ],
  "relatedScreens": [
    "ORD-18",
    "ORD-19",
    "ORD-20"
  ],
  "columns": [
    "number",
    "stage",
    "customer",
    "submittedBy",
    "dueDate",
    "priority"
  ],
  "filters": [
    "department"
  ]
}
