{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dentallabos.app/schemas/screen.schema.json",
  "title": "DentalLab OS screen specification",
  "description": "Machine-readable spec for one screen (plan section C2). Source of truth for builders, tests and the in-app assistant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "module", "titleKey", "route", "pattern", "permissions", "entities", "api", "rules", "states", "offline", "sensitive", "aiAssist", "tests"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2}$" },
    "module": { "type": "string", "pattern": "^[a-z]+$" },
    "titleKey": { "type": "string", "minLength": 3 },
    "route": { "type": "string", "pattern": "^/" },
    "routes": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
    "pattern": { "enum": ["ListPage", "FormPage", "DetailsTabs", "ActionDialog", "ApprovalQueue", "ReportPage", "DashboardPage", "AuthPage", "StatusPage", "Custom"] },
    "phase": { "type": "integer", "minimum": 0, "maximum": 15 },
    "status": { "enum": ["planned", "implemented"] },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view"],
      "properties": {
        "view": { "type": ["string", "null"], "description": "Permission key, or null for anonymous/any signed-in user (see 'access')." },
        "access": { "enum": ["anonymous", "authenticated", "permission"] },
        "actions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "entities": { "type": "array", "items": { "type": "string" } },
    "api": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path"],
        "properties": {
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/api/v1/" },
          "purpose": { "type": "string" },
          "idempotent": { "type": "boolean" }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["text", "email", "password", "code", "slug", "lookup", "multiLookup", "decimal", "integer", "boolean", "date", "datetime", "enum", "textarea", "hidden"] },
          "required": { "type": "boolean" },
          "maxLength": { "type": "integer" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "scale": { "type": "integer" },
          "source": { "type": "string" },
          "scan": { "type": "boolean" },
          "pattern": { "type": "string" }
        }
      }
    },
    "columns": { "type": "array", "items": { "type": "string" } },
    "filters": { "type": "array", "items": { "type": "string" } },
    "rules": { "type": "array", "items": { "type": "string" } },
    "states": { "type": "array", "items": { "enum": ["loading", "empty", "validationError", "conflict", "offlineBlocked", "forbidden", "notFound", "success", "locked", "expired"] } },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["blocked", "readOnlyCache", "available"] }, "why": { "type": "string" } }
    },
    "sensitive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidesCostFor": { "type": "array", "items": { "type": "string" } },
        "auditActions": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "aiAssist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden", "contextFields"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } },
        "contextFields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2}\\.[A-Za-z]+$" } },
    "relatedScreens": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2}$" } },
    "notes": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "pattern": { "const": "FormPage" } } }, "then": { "required": ["fields"] } },
    { "if": { "properties": { "pattern": { "const": "ListPage" } } }, "then": { "required": ["columns"] } }
  ]
}
